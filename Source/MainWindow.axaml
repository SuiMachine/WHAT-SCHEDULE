<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WhatSchedule.ViewModels"
        xmlns:controls="clr-namespace:WhatSchedule.Controls"
        xmlns:app="clr-namespace:WhatSchedule"
        x:Class="WhatSchedule.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="WHAT SCHEDULE?!"
        Width="1920" Height="1080"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        Background="{x:Static app:ThemeDefinition.Background}">

	<Design.DataContext>
		<vm:MainWindowViewModel />
	</Design.DataContext>

	<Window.Styles>
		<!--The window draws its own title bar (the system one is off), so it also draws its own caption buttons.-->
		<Style Selector="Button.windowButton">
			<Setter Property="Width" Value="46" />
			<Setter Property="Height" Value="32" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="Template">
				<ControlTemplate>
					<Border x:Name="Hover" Background="Transparent">
						<ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
										  HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="Button.windowButton:pointerover /template/ Border#Hover">
			<Setter Property="Background" Value="#22FFFFFF" />
		</Style>
		<Style Selector="Button.windowButton:pressed /template/ Border#Hover">
			<Setter Property="Background" Value="#14FFFFFF" />
		</Style>
		<Style Selector="Button.closeButton:pointerover /template/ Border#Hover">
			<Setter Property="Background" Value="#C42B1C" />
		</Style>
		<!--A maximized window shows the restore glyph instead of the maximize one.-->
		<Style Selector="Window[WindowState=Maximized] Path#MaximizeGlyph">
			<Setter Property="Data" Value="M0.5,0.5 L6.5,0.5 L6.5,6.5 L0.5,6.5 Z M3.5,3.5 L9.5,3.5 L9.5,9.5 L3.5,9.5 Z" />
		</Style>
	</Window.Styles>

	<Window.KeyBindings>
		<!--NativeMenuItem.Gesture only labels the menu entry; these make the shortcuts actually fire.-->
		<KeyBinding Gesture="Ctrl+O" Command="{Binding LoadCommand}" />
		<KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
		<KeyBinding Gesture="Ctrl+E" Command="{Binding ExportCommand}" />
		<!--The canvas handles these itself when it has focus and marks them handled; these cover the rest of the window.-->
		<KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
		<KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
	</Window.KeyBindings>

	<NativeMenu.Menu>
		<NativeMenu>
			<NativeMenuItem Header="File" x:DataType="vm:MainWindowViewModel">
				<NativeMenuItem.Menu>
					<NativeMenu x:DataType="vm:MainWindowViewModel">
						<NativeMenuItem Header="New..." Command="{Binding NewScheduleCommand}" Gesture="Ctrl+N" />
						<NativeMenuItem Header="Load..." Command="{Binding LoadCommand}" Gesture="Ctrl+O" />
						<NativeMenuItem Header="Save..." Command="{Binding SaveCommand}" Gesture="Ctrl+S" />
						<NativeMenuItem Header="Export..." Command="{Binding ExportCommand}" Gesture="Ctrl+E" />
						<NativeMenuItemSeparator />
						<NativeMenuItem Header="Exit" Click="OnExitClick" />
					</NativeMenu>
				</NativeMenuItem.Menu>
			</NativeMenuItem>
			<NativeMenuItem Header="Edit" x:DataType="vm:MainWindowViewModel">
				<NativeMenuItem.Menu>
					<NativeMenu x:DataType="vm:MainWindowViewModel">
						<NativeMenuItem Header="Undo" Command="{Binding UndoCommand}" Gesture="Ctrl+Z" />
						<NativeMenuItem Header="Redo" Command="{Binding RedoCommand}" Gesture="Ctrl+Y" />
						<NativeMenuItemSeparator />
						<!--Copy, cut and paste act on the canvas selection; the shortcuts themselves are handled by the canvas.-->
						<NativeMenuItem Header="Cut" Click="OnCutClick" Gesture="Ctrl+X" />
						<NativeMenuItem Header="Copy" Click="OnCopyClick" Gesture="Ctrl+C" />
						<NativeMenuItem Header="Paste" Click="OnPasteClick" Gesture="Ctrl+V" />
					</NativeMenu>
				</NativeMenuItem.Menu>
			</NativeMenuItem>
			<!--Added elements land in the top left corner, since a menu click carries no canvas position.-->
			<NativeMenuItem Header="Add...">
				<NativeMenuItem.Menu>
					<NativeMenu>
						<NativeMenuItem Header="Label..." Click="OnAddLabelClick" />
						<NativeMenuItem Header="Image..." Click="OnAddImageClick" />
					</NativeMenu>
				</NativeMenuItem.Menu>
			</NativeMenuItem>
		</NativeMenu>
	</NativeMenu.Menu>

	<!--Renders the window's NativeMenu inside the window on platforms without a system menu bar (Windows, Linux).-->
	<DockPanel LastChildFill="True">
		<!--The custom title bar: dragging it moves the window, double-tapping maximizes or restores it.-->
		<Border x:Name="TitleBar" DockPanel.Dock="Top" Height="32"
				Background="{x:Static app:ThemeDefinition.RulerBackground}"
				PointerPressed="OnTitleBarPressed" DoubleTapped="OnTitleBarDoubleTapped">
			<Grid>
				<TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
						   Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
						   Foreground="{x:Static app:ThemeDefinition.RulerLabel}" />
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
					<Button Classes="windowButton" Click="OnMinimizeClick">
						<Path Width="10" Height="10" Stroke="#FFFFFFFF" StrokeThickness="1" Data="M0.5,4.5 L9.5,4.5" />
					</Button>
					<Button Classes="windowButton" Click="OnMaximizeClick">
						<Path x:Name="MaximizeGlyph" Width="10" Height="10" Stroke="#FFFFFFFF" StrokeThickness="1" Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" />
					</Button>
					<Button Classes="windowButton closeButton" Click="OnCloseClick">
						<Path Width="10" Height="10" Stroke="#FFFFFFFF" StrokeThickness="1" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" />
					</Button>
				</StackPanel>
			</Grid>
		</Border>
		<NativeMenuBar DockPanel.Dock="Top" />
		<Grid Margin="4" Background="{x:Static app:ThemeDefinition.Background}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" MinWidth="100" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="280" MinWidth="200" />
				</Grid.ColumnDefinitions>
				<Border Grid.Column="0" BorderBrush="{x:Static app:ThemeDefinition.Border}" BorderThickness="1" ClipToBounds="True">
					<controls:PreviewCanvas x:Name="Canvas" Document="{Binding Document}" />
				</Border>
				<GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" />
				<Border Grid.Column="2" BorderBrush="{x:Static app:ThemeDefinition.Border}" BorderThickness="1" ClipToBounds="True">
					<ScrollViewer>
						<controls:InspectorPanel x:Name="Inspector" Margin="8" />
					</ScrollViewer>
				</Border>
			</Grid>
		</Grid>
	</DockPanel>

</Window>
