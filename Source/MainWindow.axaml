<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WhatSchedule.ViewModels"
        xmlns:controls="clr-namespace:WhatSchedule.Controls"
        xmlns:app="clr-namespace:WhatSchedule"
        x:Class="WhatSchedule.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="WHAT SCHEDULE?!"
        Width="1920" Height="1080"
        WindowStartupLocation="CenterScreen">

	<Design.DataContext>
		<vm:MainWindowViewModel />
	</Design.DataContext>

	<Grid RowDefinitions="Auto,Auto,*" Margin="4" Background="{x:Static app:ThemeDefinition.Background}">
		<Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,0,0,12">
			<Button Grid.Column="0" Content="New" Margin="8,0,0,0" Command="{Binding NewScheduleCommand}" />
			<Button Grid.Column="1" Content="Load..." Margin="8,0,0,0" Command="{Binding LoadCommand}" />
			<Button Grid.Column="2" Content="Save..." Margin="8,0,0,0" Command="{Binding SaveCommand}" />
			<Button Grid.Column="3" Content="Export..." Margin="8,0,0,0" Command="{Binding ExportCommand}" />
		</Grid>

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" MinWidth="100" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="280" MinWidth="200" />
			</Grid.ColumnDefinitions>
			<Border Grid.Column="0" BorderBrush="{x:Static app:ThemeDefinition.Border}" BorderThickness="1" ClipToBounds="True">
				<controls:PreviewCanvas x:Name="Canvas" Document="{Binding Document}" />
			</Border>
			<GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" />
			<Border Grid.Column="2" BorderBrush="{x:Static app:ThemeDefinition.Border}" BorderThickness="1" ClipToBounds="True">
				<ScrollViewer>
					<controls:InspectorPanel x:Name="Inspector" Margin="8" />
				</ScrollViewer>
			</Border>
		</Grid>
	</Grid>

</Window>
