<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Example\active_day_left.png" />
    <None Remove="Assets\Example\active_day_right.png" />
    <None Remove="Assets\Example\art_outline.png" />
    <None Remove="Assets\Example\art_temporary.png" />
    <None Remove="Assets\Example\background_outline.png" />
    <None Remove="Assets\Example\element_bg.png" />
    <None Remove="Assets\Example\outline.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.*" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Controls\Dialogs\ColorPickerDIalog.axaml.cs">
      <DependentUpon>ColorPickerDialog.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Example\active_day_left.png" />
    <AvaloniaResource Include="Assets\Example\active_day_right.png" />
    <AvaloniaResource Include="Assets\Example\art_outline.png" />
    <AvaloniaResource Include="Assets\Example\art_temporary.png" />
    <AvaloniaResource Include="Assets\Example\background.png" />
    <AvaloniaResource Include="Assets\Example\background_outline.png" />
    <AvaloniaResource Include="Assets\Example\element_bg.png" />
    <AvaloniaResource Include="Assets\Example\outline.png" />
  </ItemGroup>

</Project>
